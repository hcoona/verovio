<?xml version="1.0" encoding="UTF-8"?>
<?xml-model href="https://music-encoding.org/schema/5.1/mei-all.rng" type="application/xml" schematypens="http://relaxng.org/ns/structure/1.0"?>
<?xml-model href="https://music-encoding.org/schema/5.1/mei-all.rng" type="application/xml" schematypens="http://purl.oclc.org/dsdl/schematron"?>
<mei xmlns="http://www.music-encoding.org/ns/mei" meiversion="5.1">
   <meiHead>
      <fileDesc>
         <titleStmt>
            <title>Inherited pedal.style="pedline" on scoreDef and staffDef</title>
         </titleStmt>
         <pubStmt>
            <date isodate="2026-11-26">2026-11-26</date>
            <pubPlace>
               <ref target="https://github.com/rism-digital/verovio/issues/4610" />
            </pubPlace>
         </pubStmt>
         <seriesStmt>
            <title>Verovio test suite</title>
         </seriesStmt>
         <notesStmt>
            <annot>Pedal style "pedline" set on scoreDef or staffDef is resolved consistently during line pairing and rendering (excerpt after Chopin, Nocturne Op. 9 No. 2, 1832, public domain).</annot>
         </notesStmt>
      </fileDesc>
      <encodingDesc>
         <appInfo>
            <application version="6.5.0" label="2">
               <name>Verovio</name>
            </application>
         </appInfo>
      </encodingDesc>
   </meiHead>
   <music>
      <body>
         <mdiv>
            <score>
               <scoreDef pedal.style="pedline" meter.count="12" meter.unit="8" key.sig="3f">
                  <staffGrp bar.thru="true" symbol="brace">
                     <staffDef n="1" lines="5" clef.shape="G" clef.line="2" />
                     <staffDef n="2" lines="5" clef.shape="F" clef.line="4" />
                  </staffGrp>
               </scoreDef>
               <section>
                  <measure n="1">
                     <staff n="1">
                        <layer n="1">
                           <note dur="2" dots="1" oct="5" pname="g" />
                           <note dur="4" dots="1" oct="5" pname="f" />
                           <beam>
                              <note dur="8" oct="5" pname="g" />
                              <note dur="8" oct="5" pname="f" />
                              <note dur="8" oct="5" pname="e" accid.ges="f" />
                           </beam>
                        </layer>
                     </staff>
                     <staff n="2">
                        <layer n="1">
                           <beam>
                              <note dur="8" oct="2" pname="e" accid.ges="f" />
                              <chord dur="8"><note oct="3" pname="g" /><note oct="3" pname="b" accid.ges="f" /><note oct="4" pname="e" accid.ges="f" /></chord>
                              <chord dur="8"><note oct="3" pname="g" /><note oct="3" pname="b" accid.ges="f" /><note oct="4" pname="e" accid.ges="f" /></chord>
                           </beam>
                           <beam>
                              <note dur="8" oct="2" pname="f" />
                              <chord dur="8"><note oct="3" pname="a" accid.ges="f" /><note oct="3" pname="b" accid.ges="f" /><note oct="4" pname="d" /></chord>
                              <chord dur="8"><note oct="3" pname="a" accid.ges="f" /><note oct="3" pname="b" accid.ges="f" /><note oct="4" pname="d" /></chord>
                           </beam>
                           <beam>
                              <note dur="8" oct="2" pname="g" />
                              <chord dur="8"><note oct="3" pname="b" accid.ges="f" /><note oct="4" pname="e" accid.ges="f" /></chord>
                              <note dur="8" oct="2" pname="e" accid.ges="f" />
                           </beam>
                           <beam>
                              <note dur="8" oct="2" pname="a" accid.ges="f" />
                              <chord dur="8"><note oct="3" pname="a" accid.ges="f" /><note oct="4" pname="c" /><note oct="4" pname="f" /></chord>
                              <chord dur="8"><note oct="3" pname="a" accid.ges="f" /><note oct="4" pname="c" /><note oct="4" pname="f" /></chord>
                           </beam>
                        </layer>
                     </staff>
                     <pedal staff="2" tstamp="1" dir="down" />
                     <pedal staff="2" tstamp="3.5" dir="up" />
                     <pedal staff="2" tstamp="4" dir="down" />
                     <pedal staff="2" tstamp="6.5" dir="up" />
                     <pedal staff="2" tstamp="7" dir="down" />
                     <pedal staff="2" tstamp="9.5" dir="up" />
                     <pedal staff="2" tstamp="10" dir="down" />
                     <pedal staff="2" tstamp="12.5" dir="up" />
                  </measure>
               </section>
            </score>
         </mdiv>
      </body>
   </music>
</mei>
